{
  "name": "alaa-project",
  "version": "2.0.0",
  "description": "نظام حجز المواعيد للموظفين - Advanced Employee Scheduling System",
  "main": "src/app.js",
  "bin": {
    "scheduling-cli": "./src/cli/index.js"
  },
  "scripts": {
    "start": "node src/app.js",
    "dev": "nodemon src/app.js",
    "build": "tsc",
    "dev:ts": "ts-node-dev --respawn --transpile-only src/app.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:integration": "jest --testPathPattern=integration",
    "test:unit": "jest --testPathPattern=unit",
    "lint": "eslint \"src/**/*.{js,ts}\" \"tests/**/*.{js,ts}\"",
    "lint:fix": "eslint \"src/**/*.{js,ts}\" \"tests/**/*.{js,ts}\" --fix",
    "format": "prettier --write \"src/**/*.{js,ts,json}\" \"tests/**/*.{js,ts,json}\"",
    "format:check": "prettier --check \"src/**/*.{js,ts,json}\" \"tests/**/*.{js,ts,json}\"",
    "migrate": "node src/cli/index.js migration run",
    "migrate:rollback": "node src/cli/index.js migration rollback",
    "migrate:status": "node src/cli/index.js migration status",
    "migrate:generate": "node src/cli/index.js migration generate",
    "cache:clear": "node src/cli/index.js cache clear",
    "cache:stats": "node src/cli/index.js cache stats",
    "health": "node src/cli/index.js health",
    "user:create": "node src/cli/index.js user create",
    "backup": "node src/cli/index.js backup",
    "security:audit": "npm audit --audit-level high",
    "security:fix": "npm audit fix",
    "docker:build": "docker build -t scheduling-system .",
    "docker:run": "docker-compose up -d",
    "docker:stop": "docker-compose down",
    "docs:generate": "jsdoc -c jsdoc.conf.json",
    "docs:api": "swagger-jsdoc -d swaggerDef.js -o public/api-docs/swagger.json",
    "precommit": "npm run lint && npm run test",
    "prepare": "husky install"
  },
  "keywords": [
    "scheduling",
    "arabic",
    "employees",
    "appointments",
    "advanced",
    "real-time"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "body-parser": "^1.20.2",
    "commander": "^11.1.0",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.21.1",
    "express-async-errors": "^3.1.1",
    "express-async-handler": "^1.2.0",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "hpp": "^0.2.3",
    "i18next": "^23.7.6",
    "i18next-fs-backend": "^2.6.0",
    "i18next-http-middleware": "^3.5.0",
    "ioredis": "^5.3.2",
    "joi": "^17.11.0",
    "jsonwebtoken": "^9.0.2",
    "moment-timezone": "^0.6.0",
    "node-cache": "^5.1.2",
    "nodemailer": "^6.9.7",
    "reflect-metadata": "^0.1.13",
    "socket.io": "^4.7.4",
    "sqlite3": "^5.1.6",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.0",
    "uuid": "^11.1.0",
    "winston": "^3.11.0",
    "xss-clean": "^0.1.4",
    "yup": "^1.6.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.8",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.10.5",
    "@types/supertest": "^2.0.16",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "eslint": "^8.54.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-jest": "^27.6.0",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-prettier": "^5.5.3",
    "husky": "^8.0.3",
    "jest": "^29.7.0",
    "jsdoc": "^4.0.2",
    "lint-staged": "^15.1.0",
    "nodemon": "^3.0.1",
    "prettier": "^3.1.0",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3"
  },
  "lint-staged": {
    "*.{js,ts}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged",
      "pre-push": "npm test"
    }
  },
  "engines": {
    "node": ">=16.0.0"
  }
}
