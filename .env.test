# ========================================
# Environment Configuration
# ========================================
NODE_ENV=test
PORT=5001
APP_NAME="Scheduling System - Test"
APP_VERSION=1.0.0-test

# ========================================
# Database Configuration
# Use an in-memory or test-specific DB path
# Prefer using SQLite or a dedicated test DB
# ========================================
DB_PATH=./data/test_scheduling.db
DB_USER=test-user
DB_PASSWORD=test-password
DB_HOST=localhost
DB_PORT=5432

# ========================================
# JWT Configuration (Use test secrets)
# ========================================
JWT_SECRET='test-jwt-secret-12345678901234567890123456789012'
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET='test-jwt-refresh-secret-12345678901234567890123456789012'
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_SECRET=test_cookie_secret
CSRF_SECRET=test_csrf_secret

# ========================================
# Cache Configuration
# Use memory cache for test isolation
# ========================================
CACHE_TYPE=memory
CACHE_TTL=10
REDIS_URL=
REDIS_PASSWORD=

# ========================================
# Email Configuration (Disable actual sending)
# Use a mock service or local SMTP server
# ========================================
EMAIL_HOST=localhost
EMAIL_PORT=1025
EMAIL_USER=test@example.com
EMAIL_PASS=test

# ========================================
# Security Configuration
# Lower bcrypt rounds for faster hashing in tests
# ========================================
BCRYPT_ROUNDS=4
RATE_LIMIT_WINDOW=60000
RATE_LIMIT_MAX=1000

# ========================================
# File Upload Configuration
# Use a temp directory for uploads in test
# ========================================
MAX_FILE_SIZE=1048576
UPLOAD_PATH=./test_uploads

# ========================================
# CORS Configuration
# Allow all for test
# ========================================
ALLOWED_ORIGINS=http://localhost:3000
CORS_ALLOW_CREDENTIALS=true

# ========================================
# Logging & Debugging Configuration
# Enable verbose logs for test debugging
# ========================================
LOG_LEVEL=debug

# ========================================
# Monitoring & Alerts Configuration
# Disable monitoring in tests
# ========================================
SENTRY_DSN=
ROLLBAR_ACCESS_TOKEN=

# ========================================
# Session Management
# ========================================
SESSION_SECRET=test_session_secret
SESSION_EXPIRY=1800

# ========================================
# Additional Configurations
# ========================================
DEBUG=true
TRIAL_DAYS=0
VERSION=test
LICENSE_CHECK_INTERVAL=60000
API_THROTTLE_LIMIT=1000
MAX_USERS=10
