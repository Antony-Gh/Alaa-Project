# ========================================
# Environment Configuration
# ========================================
NODE_ENV=development            # Set to 'production' in production
PORT=5000                       # Port the app runs on (adjust for production)
APP_NAME="Scheduling System"
APP_VERSION=2.0.0

# ========================================
# Database Configuration
# ========================================
DB_PATH=./data/scheduling.db         # Use full paths for production (e.g., /data/db/scheduling.db)
DB_USER=your-db-username        # Database username (optional if using authentication)
DB_PASSWORD=your-db-password    # Database password (optional if using authentication)
DB_HOST=localhost               # Set this to your DB host in production (e.g., db.production.com)
DB_PORT=5432                    # Default PostgreSQL port, change if using another DB

# ========================================
# JWT (JSON Web Token) Configuration
# ========================================
JWT_SECRET=yyxIyOoKJCGs2yPn1Chxb7l8KxgxZGW9Mkm54SlIbu8OsE4m5S2NbclcjOSz0i2r  # Change to a more complex key
JWT_EXPIRES_IN=24h             # Token expiration time (change in production as needed)
JWT_REFRESH_SECRET=vL1NKbpazqcMn0Vn3clwQB2qigk7OtFIaex5VJRmIQbvyp27O4V0Y8ghijVQLbLk
JWT_REFRESH_EXPIRES_IN=7d      # Refresh token expiration
COOKIE_SECRET=0OUVKRCSAe5GCn39XBbTVZIo86FttFPW0hmIoZ7N6MAIGFhjjIS0RxiZF1ssIXwW
CSRF_SECRET=fwVAbZWmJ6WVTOkctG6baitu4CUrSgpnWwAIj3B1JTBXKARQ3N5WM3Du92eLrBYY

# ========================================
# Cache Configuration
# ========================================
CACHE_TYPE=memory              # Use 'redis' in production for scalable cache
CACHE_TTL=3600                 # Cache time-to-live (in seconds) for cached items
REDIS_URL=redis://localhost:6379 # Uncomment and configure for Redis in production
REDIS_PASSWORD=changeme

# ========================================
# Email Configuration
# ========================================
EMAIL_HOST=smtp.your-email.com  # SMTP host (e.g., Gmail, SendGrid, Mailgun)
EMAIL_PORT=587                 # Port for SMTP (587 is common for TLS)
EMAIL_USER=your-email@example.com  # SMTP username
EMAIL_PASS=your-email-password    # SMTP password

# ========================================
# Security Configuration
# ========================================
BCRYPT_ROUNDS=12               # Increase for production to strengthen hashed passwords
RATE_LIMIT_WINDOW=900000       # Rate limit window in milliseconds (15 minutes here)
RATE_LIMIT_MAX=100             # Maximum requests allowed per window

# ========================================
# File Upload Configuration
# ========================================
MAX_FILE_SIZE=5242880          # Maximum file size (in bytes, 5MB here)
UPLOAD_PATH=./uploads          # Path to store uploaded files (ensure directory is writable)

# ========================================
# CORS Configuration
# ========================================
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5000,http://localhost:5173   # Add your frontend URLs here
CORS_ALLOW_CREDENTIALS=true    # Allow credentials (cookies, authorization headers, etc.)

# ========================================
# Logging & Debugging Configuration
# ========================================
LOG_LEVEL=info                 # 'debug', 'info', 'warn', 'error' (adjust for production)

# ========================================
# Monitoring & Alerts Configuration
# ========================================
SENTRY_DSN=your-sentry-dsn      # Sentry DSN for error tracking in production
ROLLBAR_ACCESS_TOKEN=your-rollbar-token  # Rollbar token for error monitoring

# ========================================
# Session Management
# ========================================
SESSION_SECRET=jVAYNknJc32vaDlaFMMnwVGpreyChgFJKtXkkQEewig8Ph34Sv4hjObB49RZy5qk  # Use a strong session secret
SESSION_EXPIRY=3600                # Session expiry time in seconds (1 hour here)

# ========================================
# Additional Configurations
# ========================================
DEBUG=true                        # Set to 'false' in production

# Trial License Configuration
# The application will automatically enter trial mode if no license is found
TRIAL_DAYS=14

# Docker Configuration
VERSION=latest

# Logging Configuration
LOG_LEVEL=info

# DO NOT modify the following settings as they affect licensing
# If you need to change these settings, please contact support
LICENSE_CHECK_INTERVAL=3600000
API_THROTTLE_LIMIT=100
MAX_USERS=50 